<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="28dp"
    android:background="#FFF5EC">


    <TextView
        android:id="@+id/txtPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 6"
        android:textSize="22sp"
        android:textColor="#30231D"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="30dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="28dp"
        android:elevation="12dp">

        <ImageView
            android:id="@+id/imgArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/artspace1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Artwork Image" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FCEADF"
        android:padding="16dp"
        android:layout_marginTop="28dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watercolour"
            android:textSize="28sp"
            android:textColor="#30231D"
            android:maxLines="2" />

        <TextView
            android:id="@+id/txtArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="William Morris (2019)"
            android:textSize="17sp"
            android:textColor="#30231D"
            android:layout_marginTop="4dp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="35dp">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Previous"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_diseable"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Next"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_enable"
            android:layout_marginStart="14dp"
            android:elevation="0dp" />

    </LinearLayout>

</LinearLayout>
