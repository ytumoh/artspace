<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#FFF5EC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artwork Details"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#30231D"
        android:layout_marginBottom="30dp" />

    <TextView
        android:id="@+id/txtArtworkDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FCEADF"
        android:padding="24dp"
        android:textSize="20sp"
        android:textColor="#30231D"
        android:gravity="center"
        android:lineSpacingExtra="10dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:text="Back to Gallery"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/btn_enable" />
    <Button
        android:id="@+id/btnVisitWeb"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="15dp"
        android:text="Visit Website"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/btn_enable" />
</LinearLayout>